{
  "name": "UniHub Flutter",
  "image": "mcr.microsoft.com/devcontainers/universal:2",

  "features": {
    "ghcr.io/cirruslabs/flutter:latest": {
      "version": "stable"
    }
  },

  "postCreateCommand": "flutter doctor",

  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code"
      ]
    }
  }
}